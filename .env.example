# Copy this file to .env.local for local testing. On Vercel, add the same names under
# Settings -> Environment Variables. Never commit real values.

# Added automatically when you connect a Neon database from Vercel's Storage tab
DATABASE_URL=

# Password for the /admin page (pick a long one)
ADMIN_PASSWORD=

# Event dates, ISO format with timezone offset. Leave empty to show "TBD" (and keep forms open).
# Example: 2026-11-13T18:00:00-08:00
REGISTRATION_CLOSES=
KICKOFF_AT=
SUBMISSIONS_CLOSE=
WINNERS_ANNOUNCED=

# Confirmation emails via Amazon SES (leave empty to turn emails off).
# Vercel reserves the AWS_* names, so these use an SES_ prefix.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Verified SES sender (no-reply): AI Hackathon <alerts@ssidecisions.com>
EMAIL_FROM=
# Where people should write instead (emails say replies aren't possible); comma-separate for several
CONTACT_EMAIL=sjoiya@ssidecisions.com, gali@ssidecisions.com
# Organizer copy of every email (comma-separate for several)
EMAIL_BCC=
# Public address used in email links
SITE_URL=https://ssi-ai-hackathon.vercel.app

# Timezone used to display the dates above, e.g. America/Los_Angeles or Asia/Karachi
EVENT_TIMEZONE=UTC

# Allowed registration email domain(s), comma-separated
ALLOWED_EMAIL_DOMAINS=ssidecisions.com
