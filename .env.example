# Copy this file to .env.local for local testing. On Vercel, add the same names under
# Settings -> Environment Variables. Never commit real values.

# Added automatically when you connect a Neon database from Vercel's Storage tab
DATABASE_URL=

# Admins sign in at /admin with their email + ADMIN_PASSWORD. Only emails listed in ADMINS can (email=Name, comma-separated).
ADMIN_PASSWORD=
ADMINS=sjoiya@ssidecisions.com=Saad, gali@ssidecisions.com=Gali
# Stage 1: the AI Architect team filters and scores entries on /architect (email=Name entries, comma-separated)
ARCHITECTS=sjoiya@ssidecisions.com=Saad, jane@ssidecisions.com=Jane Smith
# Optional; if empty, architects sign in with JUDGE_PASSWORD
ARCHITECT_PASSWORD=
# Shared password Stage 2 and Stage 3 judges use on /judge. Must differ from ADMIN_PASSWORD.
JUDGE_PASSWORD=
# Who scores each criterion (email=Name entries, comma-separated; the portal shows the name). Judges score only their criteria.
# Stage 2 on /judge: Creativity & uniqueness and Business value
CREATIVITY_JUDGES=jane@ssidecisions.com=Jane Smith
BUSINESS_JUDGES=jane@ssidecisions.com=Jane Smith
# Stage 3 on /judge/stage-3: Presentation & live product
PRESENTATION_JUDGES=jane@ssidecisions.com=Jane Smith, john@ssidecisions.com=John Doe
# Only used if the three lists above are all empty: everyone here scores all three judged criteria
JUDGES=

# Optional: override the event dates set in lib/config.ts (Pakistan time). ISO format with offset.
# Example: 2026-11-15T23:59:00+05:00
# Set to true to close the forms automatically on their dates (by default they stay open)
ENFORCE_DATES=
REGISTRATION_OPENS=
REGISTRATION_CLOSES=
KICKOFF_AT=
SUBMISSIONS_CLOSE=
WINNERS_ANNOUNCED=

# Confirmation emails via Amazon SES (leave empty to turn emails off).
# Vercel reserves the AWS_* names, so these use an SES_ prefix.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Verified SES sender (no-reply): AI Hackathon <alerts@ssidecisions.com>
EMAIL_FROM=
# Where people should write instead (emails say replies aren't possible); comma-separate for several
CONTACT_EMAIL=sjoiya@ssidecisions.com, gali@ssidecisions.com
# Extra organizer copies of every email (comma-separate); gali@ssidecisions.com always gets one
EMAIL_BCC=
# Public address used in email links
SITE_URL=https://ssi-ai-hackathon.vercel.app

# Allowed registration email domain(s), comma-separated
ALLOWED_EMAIL_DOMAINS=ssidecisions.com
